packages:
  pgmq-core
  pgmq-hasql
  pgmq-effectful
  pgmq-migration
  pgmq-config
  pgmq-bench

with-compiler: ghc-9.12.4

test-show-details: direct

tests: True

benchmarks: True

package pg-migrate
  tests: False

package pg-migrate-embed
  tests: False

package pg-migrate-cli
  tests: False

package pg-migrate-import-hasql-migration
  tests: False

package pg-migrate-test-support
  tests: False

allow-newer:
  -- GHC 9.12 ships with updated boot libraries
  *:time
  , *:containers
  , *:template-haskell
  , *:text
  , *:bytestring
  , *:base
  , *:ghc-prim
  , *:deepseq
  , *:filepath
  , openapi3:time

-- pg-migrate's v1 packages are tagged but not yet published to Hackage.
source-repository-package
  type: git
  location: https://github.com/shinzui/pg-migrate.git
  tag: v1.1.0.0
  subdir: pg-migrate

source-repository-package
  type: git
  location: https://github.com/shinzui/pg-migrate.git
  tag: v1.1.0.0
  subdir: pg-migrate-embed

source-repository-package
  type: git
  location: https://github.com/shinzui/pg-migrate.git
  tag: v1.1.0.0
  subdir: pg-migrate-cli

source-repository-package
  type: git
  location: https://github.com/shinzui/pg-migrate.git
  tag: v1.1.0.0
  subdir: pg-migrate-import-hasql-migration

source-repository-package
  type: git
  location: https://github.com/shinzui/pg-migrate.git
  tag: v1.1.0.0
  subdir: pg-migrate-test-support

source-repository-package
  type: git
  location: https://github.com/nikita-volkov/hasql
  tag: aa3d6ae499e187c291422443f221f9f486c43a9e

source-repository-package
  type: git
  location: https://github.com/nikita-volkov/hasql-pool
  tag: 35e4c2a9d6b314fbc051e3ca31639bd83dad9f39

source-repository-package
  type: git
  location: https://github.com/nikita-volkov/hasql-transaction
  tag: 6cb37f68bf6f5d378f15bace9d054c6d5ad99583

-- hs-opentelemetry from GitHub (main branch for GHC 9.12 support)
source-repository-package
  type: git
  location: https://github.com/iand675/hs-opentelemetry
  tag: 46a42cdf80405fdb36fbb48a309254b2332617b4
  subdir:
    api-types
    api
    propagators/w3c
    semantic-conventions
    sdk
    exporters/in-memory
